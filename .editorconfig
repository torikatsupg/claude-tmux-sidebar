root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Shell scripts (also read by shfmt).
[{*.sh,*.tmux,bin/cts,bin/cts-hook}]
indent_size = 2
switch_case_indent = true

[*.{yml,yaml,json,md}]
indent_size = 2
