#!/usr/bin/env bash
# Claude Code hook: records the session's status as a JSON file for the sidebar.
# Registered for every hook event; reads the hook payload from stdin. Never fails.

set -u
umask 077 # state files and the debug log are private to the user
STATE_DIR="${CTS_STATE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/claude-tmux-sidebar}"
mkdir -p "$STATE_DIR" 2>/dev/null || exit 0

payload=$(cat)
[ -n "${CTS_DEBUG:-}" ] && printf '%s\n' "$payload" >>"$STATE_DIR/debug.log"

IFS=$'\x1f' read -r event sid ntype tool cwd < <(
  jq -r '[.hook_event_name // "", .session_id // "", .notification_type // "", .tool_name // "", .cwd // ""] | join("\u001f")' <<<"$payload" 2>/dev/null
)
[ -z "${sid:-}" ] && exit 0
file="$STATE_DIR/$sid.json"

if [ "$event" = "SessionEnd" ]; then
  rm -f "$file"
  exit 0
fi

prev_state=""; prev_pid=""; prev_since=""
if [ -f "$file" ]; then
  IFS=$'\x1f' read -r prev_state prev_pid prev_since < <(
    jq -r '[.state // "", (.pid // "" | tostring), (.since // "" | tostring)] | join("\u001f")' "$file" 2>/dev/null
  )
fi

detail=""
case "$event" in
  SessionStart)              state="${prev_state:-idle}" ;;
  UserPromptSubmit)          state="running" ;;
  # AskUserQuestion blocks on the user like an approval prompt.
  PreToolUse)
    if [ "$tool" = "AskUserQuestion" ]; then state="waiting"; detail="Question"; else state="running"; detail="$tool"; fi ;;
  PostToolUse)               state="running"; detail="$tool" ;;
  PermissionRequest)         state="waiting"; detail="$tool" ;;
  Notification)
    case "$ntype" in
      permission_prompt|elicitation_dialog) state="waiting" ;;
      # Fires after ~60s of inactivity: also recovers from an interrupted (Esc) turn, which skips Stop.
      idle_prompt) [ "$prev_state" = "running" ] && state="idle" || state="${prev_state:-idle}" ;;
      *) exit 0 ;;
    esac ;;
  Stop)                      state="done" ;;
  *)                         exit 0 ;;
esac

# Keep the tool name visible while waiting for approval (Notification carries no tool_name).
if [ "$state" = "waiting" ] && [ -z "$detail" ] && { [ "$prev_state" = "waiting" ] || [ "$prev_state" = "running" ]; } && [ -f "$file" ]; then
  detail=$(jq -r '.detail // ""' "$file" 2>/dev/null)
fi

# The Claude process pid lets the sidebar drop sessions whose process died without SessionEnd.
pid="$prev_pid"
if [ -z "$pid" ]; then
  p=$PPID
  for _ in 1 2 3 4 5 6; do
    [ -z "$p" ] || [ "$p" -le 1 ] && break
    read -r pp comm < <(ps -o ppid=,comm= -p "$p" 2>/dev/null)
    case "${comm##*/}" in
      claude) pid=$p; break ;;
      # npm installs run as `node .../@anthropic-ai/claude-code/cli.js`.
      node) case "$(ps -o args= -p "$p" 2>/dev/null)" in *claude*) pid=$p; break ;; esac ;;
    esac
    p=$pp
  done
fi

now=$(date +%s)
since=$now
[ "$state" = "$prev_state" ] && [ -n "$prev_since" ] && since=$prev_since

tmux_env="${TMUX:-}" # unset when Claude runs outside tmux
tmp="$file.$$"
jq -n \
  --arg sid "$sid" --arg state "$state" --arg detail "$detail" --arg cwd "$cwd" \
  --arg pane "${TMUX_PANE:-}" --arg socket "${tmux_env%%,*}" --arg pid "$pid" \
  --argjson now "$now" --argjson since "$since" \
  '{session_id:$sid, state:$state, detail:$detail, cwd:$cwd, pane:$pane, socket:$socket,
    pid:($pid|tonumber? // null), since:$since, updated_at:$now}' >"$tmp" 2>/dev/null && mv -f "$tmp" "$file"
rm -f "$tmp"
exit 0
