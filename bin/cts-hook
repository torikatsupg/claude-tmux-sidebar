#!/bin/sh
# Claude Code hook entry point. It must never hold Claude up: without the binary it starts installing it
# in the background and skips this event.
dir=$(cd "$(dirname "$0")" && pwd)
bin="$dir/claude-tmux-sidebar"
[ -x "$bin" ] && exec "$bin" hook
nohup "$dir/../scripts/fetch-binary.sh" >/dev/null 2>&1 &
exit 0
