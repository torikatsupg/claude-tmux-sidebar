#!/usr/bin/env python3
"""Sidebar / popup UI listing every Claude Code session, grouped by tmux session."""

import curses
import json
import locale
import os
import subprocess
import sys
import time
import unicodedata

STATE_DIR = os.environ.get("CTS_STATE_DIR") or os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "claude-tmux-sidebar"
)
BIN_DIR = os.path.dirname(os.path.realpath(__file__))
POPUP = "--popup" in sys.argv
MY_PANE = os.environ.get("TMUX_PANE", "")
MY_SOCKET = os.environ.get("TMUX", "").split(",")[0]
ORIGIN_PANE = os.environ.get("CTS_ORIGIN_PANE", "")  # popup: the pane it was opened from


def tmux(*args):
    try:
        return subprocess.run(["tmux", *args], capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


MESSAGES = {
    "en": {"waiting": "waiting", "running": "running", "done": "done", "idle": "idle",
           "outside": "(outside tmux)", "no_sessions": "No sessions", "none": "none",
           "help": "⏎ jump  j/k move  q close",
           "nothing": "No done or waiting Claude sessions"},
    "ja": {"waiting": "承認待ち", "running": "稼働中", "done": "完了", "idle": "待機",
           "outside": "(tmux外)", "no_sessions": "セッションなし", "none": "なし",
           "help": "⏎移動 j/k選択 q閉じる",
           "nothing": "完了・承認待ちの Claude はありません"},
}
T = MESSAGES.get(tmux("show", "-gqv", "@cts_lang").strip(), MESSAGES["en"])
OUTSIDE = T["outside"]

SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
STATES = {  # state -> (icon, label, color pair)
    "waiting": ("◆", T["waiting"], 2),
    "running": ("●", T["running"], 1),
    "done": ("✓", T["done"], 3),
    "idle": ("○", T["idle"], 4),
}
ATTENTION = ("waiting", "done")  # states `cts next` / `cts prev` and n/p visit


def width_of(s):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 0 if unicodedata.combining(c) else 1 for c in s)


def truncate(s, w):
    if w <= 0:
        return ""
    if width_of(s) <= w:
        return s
    out, used = "", 0
    for c in s:
        cw = width_of(c)
        if used + cw > w - 1:
            break
        out, used = out + c, used + cw
    return out + "…"


def age(seconds):
    if seconds < 60:
        return f"{int(seconds)}s"
    if seconds < 3600:
        return f"{int(seconds // 60)}m"
    if seconds < 86400:
        return f"{int(seconds // 3600)}h"
    return f"{int(seconds // 86400)}d"


def pid_alive(pid):
    if not pid:
        return True
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def live_panes():
    fmt = "\t".join(["#{pane_id}", "#{session_name}", "#{window_index}", "#{window_name}", "#{pane_index}", "#{window_id}",
                     "#{@cts_sidebar}", "#{pane_active}", "#{pane_last}"])
    panes = {}
    for line in tmux("list-panes", "-a", "-F", fmt).splitlines():
        parts = line.split("\t")
        if len(parts) == 9:
            pid, sess, widx, wname, pidx, wid, sidebar, active, last = parts
            panes[pid] = {"session": sess, "window": int(widx), "window_name": wname, "pane_index": int(pidx),
                          "window_id": wid, "sidebar": sidebar == "1", "active": active == "1", "last": last == "1"}
    return panes


def tmux_sessions():
    return [s for s in tmux("list-sessions", "-F", "#{session_name}").splitlines() if s]


def focused_pane(panes, window_id):
    """The non-sidebar pane the user is working in: the active one, or the previous one while the sidebar has focus."""
    same = [(pid, p) for pid, p in panes.items() if p["window_id"] == window_id and not p["sidebar"]]
    for key in ("active", "last"):
        for pid, p in same:
            if p[key]:
                return pid
    return same[0][0] if same else None


def grouped(sessions):
    """Claude sessions per tmux session, in tmux's own session / window / pane order; sessions outside tmux last."""
    groups = {name: [] for name in tmux_sessions()}
    for e in sessions:
        groups.setdefault(e["tmux"]["session"] if e["tmux"] else OUTSIDE, []).append(e)
    if OUTSIDE in groups:
        groups[OUTSIDE] = groups.pop(OUTSIDE)
    for items in groups.values():
        items.sort(key=lambda e: (e["tmux"]["window"], e["tmux"]["pane_index"]) if e["tmux"] else (0, 0))
    return groups


def goto_pane(pane, client=""):
    target = ["-c", client] if client else []
    tmux("switch-client", *target, "-t", pane)
    tmux("select-window", "-t", pane)
    tmux("select-pane", "-t", pane)


def jump_attention(direction, current, client):
    """`cts next|prev`: goes to the next / previous done or waiting Claude after the current pane, wrapping around."""
    panes = live_panes()
    groups = grouped(load_sessions(panes))
    order = {name: i for i, name in enumerate(groups)}

    def pos(p):
        return (order.get(p["session"], len(order)), p["window"], p["pane_index"])

    targets = [e for items in groups.values() for e in items if e["tmux"] and e.get("state") in ATTENTION]
    if not targets:
        tmux("display-message", *(["-c", client] if client else []), T["nothing"])
        return
    me = panes.get(current)
    if me and me["sidebar"]:
        me = panes.get(focused_pane(panes, me["window_id"]))
    if not me:
        goto_pane(targets[0]["pane"], client)
        return
    here = pos(me)
    if direction == "next":
        e = next((e for e in targets if pos(e["tmux"]) > here), targets[0])
    else:
        e = next((e for e in reversed(targets) if pos(e["tmux"]) < here), targets[-1])
    goto_pane(e["pane"], client)


def load_sessions(panes):
    """Reads state files, removes ones whose pane or process is gone, keeps the newest per pane."""
    entries = []
    try:
        names = os.listdir(STATE_DIR)
    except FileNotFoundError:
        return []
    for name in names:
        if not name.endswith(".json"):
            continue
        path = os.path.join(STATE_DIR, name)
        try:
            with open(path) as f:
                e = json.load(f)
        except (OSError, ValueError):
            continue
        same_server = e.get("socket") == MY_SOCKET
        if not pid_alive(e.get("pid")) or (same_server and e.get("pane") and e["pane"] not in panes):
            try:
                os.remove(path)
            except OSError:
                pass
            continue
        if e.get("socket") and not same_server:
            continue  # belongs to another tmux server
        e["tmux"] = panes.get(e.get("pane")) if same_server else None
        entries.append(e)

    newest = {}
    for e in entries:
        key = e.get("pane") or e["session_id"]
        if key not in newest or e.get("updated_at", 0) > newest[key].get("updated_at", 0):
            newest[key] = e
    return list(newest.values())


class App:
    def __init__(self, scr):
        self.scr = scr
        self.sessions = []
        self.rows = []  # (kind, payload): ("group", name) | ("item", entry) | ("none", None) | ("blank", None)
        self.selected = None  # key of the selected row: ("group", name) | ("item", session_id)
        self.focused = None  # (pane, key) last synced to; selection follows it when the user moves focus
        self.my_window = None
        self.last_load = 0
        self.last_mtime = None
        self.frame = 0

        curses.curs_set(0)
        curses.use_default_colors()
        for i, c in enumerate([curses.COLOR_GREEN, curses.COLOR_YELLOW, curses.COLOR_CYAN, 8 if curses.COLORS > 8 else curses.COLOR_WHITE, curses.COLOR_MAGENTA], 1):
            curses.init_pair(i, c, -1)
        curses.mousemask(curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED)
        scr.timeout(150)

    def reload(self):
        panes = live_panes()
        me = panes.get(ORIGIN_PANE if POPUP else MY_PANE)
        if me:
            self.my_window = me["window_id"]
            if not POPUP and self.redundant(panes, me["window_id"]):
                tmux("kill-pane", "-t", MY_PANE)
                sys.exit(0)
        self.sessions = load_sessions(panes)

        self.rows = []
        for g, items in grouped(self.sessions).items():
            if self.rows:
                self.rows.append(("blank", None))
            self.rows.append(("group", g))
            self.rows.extend(("item", e) for e in items)
            if not items:
                self.rows.append(("none", None))

        keys = self.keys()
        pane = focused_pane(panes, self.my_window) if self.my_window else None
        focus_key = self.key_for_pane(pane, panes)
        # The selection is the user's only while the sidebar has the focus; otherwise it mirrors the focused pane.
        mirror = not POPUP and me and not me["active"]
        if focus_key in keys and (mirror or (pane, focus_key) != self.focused):
            self.focused = (pane, focus_key)
            self.selected = focus_key
        if self.selected not in keys:
            self.selected = focus_key if focus_key in keys else (keys[0] if keys else None)
        self.last_load = time.time()

    def key_for_pane(self, pane, panes):
        if not pane:
            return None
        for kind, p in self.rows:
            if kind == "item" and p.get("pane") == pane:
                return ("item", p["session_id"])
        return ("group", panes[pane]["session"])

    @staticmethod
    def redundant(panes, window_id):
        """True when the window has no real pane left, or an older sidebar (concurrent tmux hooks can add two)."""
        same = [(int(pid[1:]), p) for pid, p in panes.items() if p["window_id"] == window_id]
        if all(p["sidebar"] for _, p in same):
            return True
        return min(n for n, p in same if p["sidebar"]) != int(MY_PANE[1:])

    def maybe_reload(self):
        try:
            mtime = os.stat(STATE_DIR).st_mtime
        except FileNotFoundError:
            mtime = None
        if mtime != self.last_mtime or time.time() - self.last_load > 0.5:
            self.last_mtime = mtime
            self.reload()

    def put(self, y, x, s, attr=0):
        h, w = self.scr.getmaxyx()
        if 0 <= y < h and x < w:
            try:
                self.scr.addstr(y, x, truncate(s, w - x), attr)
            except curses.error:
                pass

    def draw(self):
        scr = self.scr
        scr.erase()
        h, w = scr.getmaxyx()
        now = time.time()

        counts = {s: 0 for s in STATES}
        for e in self.sessions:
            counts[e.get("state", "idle")] = counts.get(e.get("state", "idle"), 0) + 1
        self.put(0, 1, "Claude", curses.A_BOLD | curses.color_pair(5))
        x = 8
        for s in ("running", "waiting", "done"):
            if counts.get(s):
                icon, _, color = STATES[s]
                text = f"{icon}{counts[s]} "
                self.put(0, x, text, curses.color_pair(color))
                x += width_of(text)
        self.put(1, 0, "─" * w, curses.color_pair(4))

        self.row_at = {}
        y = 2
        if not self.rows:
            self.put(y, 1, T["no_sessions"], curses.color_pair(4))
        for kind, p in self.rows:
            if y >= h - 1:
                break
            if kind == "group":
                sel = ("group", p) == self.selected
                if sel:
                    self.put(y, 0, " " * w, curses.A_REVERSE)
                self.put(y, 1, f"▾ {p}", curses.A_BOLD | (curses.A_REVERSE if sel else 0))
                if p != OUTSIDE:
                    self.row_at[y] = ("group", p)
            elif kind == "item":
                self.draw_item(y, w, p, now)
                self.row_at[y] = ("item", p["session_id"])
            elif kind == "none":
                self.put(y, 3, T["none"], curses.color_pair(4))
            y += 1
        self.put(h - 1, 1, T["help"], curses.color_pair(4))
        scr.refresh()

    def draw_item(self, y, w, e, now):
        state = e.get("state", "idle")
        icon, label, color = STATES.get(state, STATES["idle"])
        if state == "running":
            icon = SPINNER[self.frame % len(SPINNER)]
        sel = ("item", e["session_id"]) == self.selected
        here = e["tmux"] and e["tmux"]["window_id"] == self.my_window
        base = curses.A_REVERSE if sel else 0

        name = os.path.basename(e.get("cwd") or "") or "?"
        if e["tmux"]:
            name = f"{e['tmux']['window']}:{name}"
        detail = e.get("detail") or ""
        right = f"{label} {age(now - e.get('since', e.get('updated_at', now)))}"
        if state in ("running", "waiting") and detail:
            right = f"{detail} {right}"

        if sel:
            self.put(y, 0, " " * w, base)
        self.put(y, 1, icon, base | curses.color_pair(color) | (curses.A_BOLD if state == "waiting" else 0))
        right_w = min(width_of(right), max(0, w - 12))
        right = truncate(right, right_w)
        name_w = w - 4 - right_w - 1
        self.put(y, 3, truncate(name, name_w), base | (curses.A_BOLD if here else 0))
        self.put(y, w - width_of(right) - 1, right, base | curses.color_pair(color))

    def keys(self):
        """Selectable rows in display order: tmux session headers and Claude sessions."""
        out = []
        for k, p in self.rows:
            if k == "group" and p != OUTSIDE:
                out.append(("group", p))
            elif k == "item":
                out.append(("item", p["session_id"]))
        return out

    def move_attention(self, d):
        """Selects the next / previous done or waiting session, wrapping around."""
        keys = self.keys()
        hits = [("item", e["session_id"]) for k, e in self.rows if k == "item" and e.get("state") in ATTENTION]
        if not hits:
            return
        i = keys.index(self.selected) if self.selected in keys else -1
        if d > 0:
            self.selected = next((k for k in hits if keys.index(k) > i), hits[0])
        else:
            self.selected = next((k for k in reversed(hits) if keys.index(k) < i), hits[-1])

    def move(self, d):
        keys = self.keys()
        if not keys:
            return
        i = keys.index(self.selected) if self.selected in keys else 0
        self.selected = keys[max(0, min(len(keys) - 1, i + d))]

    def jump(self, key):
        if not key:
            return False
        kind, val = key
        if kind == "group":
            target = f"={val}"
            leaving = self.leaving(tmux("display", "-p", "-t", target, "#{window_id}").strip())
            tmux("switch-client", "-t", target)
        else:
            e = next((e for e in self.sessions if e["session_id"] == val), None)
            if not e or not e["tmux"]:
                return False
            leaving = self.leaving(e["tmux"]["window_id"])
            goto_pane(e["pane"])
        if leaving:
            # Hand this window's focus back to the pane the user was in, so it isn't on the sidebar when they return.
            tmux("last-pane", "-t", MY_PANE)
        return True

    def leaving(self, window):
        """True when jumping to another window while this sidebar has the focus."""
        if POPUP or not window or window == self.my_window:
            return False
        return tmux("display", "-p", "-t", MY_PANE, "#{pane_active}").strip() == "1"

    def run(self):
        self.reload()
        while True:
            self.maybe_reload()
            self.draw()
            self.frame += 1
            k = self.scr.getch()
            if k == -1:
                continue
            if k in (ord("j"), curses.KEY_DOWN):
                self.move(1)
            elif k in (ord("k"), curses.KEY_UP):
                self.move(-1)
            elif k == ord("n"):
                self.move_attention(1)
            elif k == ord("p"):
                self.move_attention(-1)
            elif k in (ord("g"), curses.KEY_HOME):
                self.move(-10**6)
            elif k in (ord("G"), curses.KEY_END):
                self.move(10**6)
            elif k in (10, 13, curses.KEY_ENTER, ord("l")):
                if self.jump(self.selected) and POPUP:
                    return
            elif k == ord("q") or (k == 27 and POPUP):
                if POPUP:
                    return
                # Detached via tmux: closing all sidebars kills this pane (and its children) too.
                tmux("run-shell", "-b", f"'{os.path.join(BIN_DIR, 'cts')}' off")
                return
            elif k == ord("r"):
                self.reload()
            elif k == curses.KEY_MOUSE:
                try:
                    _, _, my, _, _ = curses.getmouse()
                except curses.error:
                    continue
                key = self.row_at.get(my)
                if key:
                    self.selected = key
                    if self.jump(key) and POPUP:
                        return


def main():
    if len(sys.argv) > 2 and sys.argv[1] == "--jump":  # --jump next|prev [pane] [client]
        args = sys.argv[2:] + ["", ""]
        jump_attention(args[0], args[1], args[2])
        return
    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")
    try:
        curses.wrapper(lambda scr: App(scr).run())
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
