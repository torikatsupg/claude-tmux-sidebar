#!/usr/bin/env python3
"""Sidebar / popup UI listing every Claude Code session, grouped by tmux session."""

import curses
import json
import locale
import os
import subprocess
import sys
import time
import unicodedata

STATE_DIR = os.environ.get("CTS_STATE_DIR") or os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "claude-tmux-sidebar"
)
BIN_DIR = os.path.dirname(os.path.realpath(__file__))
POPUP = "--popup" in sys.argv
MY_PANE = os.environ.get("TMUX_PANE", "")
MY_SOCKET = os.environ.get("TMUX", "").split(",")[0]

SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
STATES = {  # state -> (icon, label, color pair, sort order within summary)
    "waiting": ("◆", "承認待ち", 2),
    "running": ("●", "稼働中", 1),
    "done": ("✓", "完了", 3),
    "idle": ("○", "待機", 4),
}


def tmux(*args):
    try:
        return subprocess.run(["tmux", *args], capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def width_of(s):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 0 if unicodedata.combining(c) else 1 for c in s)


def truncate(s, w):
    if w <= 0:
        return ""
    if width_of(s) <= w:
        return s
    out, used = "", 0
    for c in s:
        cw = width_of(c)
        if used + cw > w - 1:
            break
        out, used = out + c, used + cw
    return out + "…"


def age(seconds):
    if seconds < 60:
        return f"{int(seconds)}s"
    if seconds < 3600:
        return f"{int(seconds // 60)}m"
    if seconds < 86400:
        return f"{int(seconds // 3600)}h"
    return f"{int(seconds // 86400)}d"


def pid_alive(pid):
    if not pid:
        return True
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def live_panes():
    fmt = "\t".join(["#{pane_id}", "#{session_name}", "#{window_index}", "#{window_name}", "#{pane_index}", "#{window_id}", "#{@cts_sidebar}"])
    panes = {}
    for line in tmux("list-panes", "-a", "-F", fmt).splitlines():
        parts = line.split("\t")
        if len(parts) == 7:
            pid, sess, widx, wname, pidx, wid, sidebar = parts
            panes[pid] = {"session": sess, "window": int(widx), "window_name": wname, "pane_index": int(pidx),
                          "window_id": wid, "sidebar": sidebar == "1"}
    return panes


def load_sessions(panes):
    """Reads state files, removes ones whose pane or process is gone, keeps the newest per pane."""
    entries = []
    try:
        names = os.listdir(STATE_DIR)
    except FileNotFoundError:
        return []
    for name in names:
        if not name.endswith(".json"):
            continue
        path = os.path.join(STATE_DIR, name)
        try:
            with open(path) as f:
                e = json.load(f)
        except (OSError, ValueError):
            continue
        same_server = e.get("socket") == MY_SOCKET
        if not pid_alive(e.get("pid")) or (same_server and e.get("pane") and e["pane"] not in panes):
            try:
                os.remove(path)
            except OSError:
                pass
            continue
        if e.get("socket") and not same_server:
            continue  # belongs to another tmux server
        e["tmux"] = panes.get(e.get("pane")) if same_server else None
        entries.append(e)

    newest = {}
    for e in entries:
        key = e.get("pane") or e["session_id"]
        if key not in newest or e.get("updated_at", 0) > newest[key].get("updated_at", 0):
            newest[key] = e
    return list(newest.values())


class App:
    def __init__(self, scr):
        self.scr = scr
        self.sessions = []
        self.rows = []  # (kind, payload): ("group", name) | ("item", entry) | ("blank", None)
        self.selected_id = None
        self.my_session = None
        self.my_window = None
        self.last_load = 0
        self.last_mtime = None
        self.frame = 0

        curses.curs_set(0)
        curses.use_default_colors()
        for i, c in enumerate([curses.COLOR_GREEN, curses.COLOR_YELLOW, curses.COLOR_CYAN, 8 if curses.COLORS > 8 else curses.COLOR_WHITE, curses.COLOR_MAGENTA], 1):
            curses.init_pair(i, c, -1)
        curses.mousemask(curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED)
        scr.timeout(150)

    def reload(self):
        panes = live_panes()
        me = panes.get(MY_PANE)
        if me:
            self.my_session, self.my_window = me["session"], me["window_id"]
            if not POPUP and self.redundant(panes, me["window_id"]):
                tmux("kill-pane", "-t", MY_PANE)
                sys.exit(0)
        self.sessions = load_sessions(panes)

        groups = {}
        for e in self.sessions:
            groups.setdefault(e["tmux"]["session"] if e["tmux"] else "(tmux外)", []).append(e)
        order = sorted(groups, key=lambda g: (g != self.my_session, g == "(tmux外)", g))
        self.rows = []
        for g in order:
            if self.rows:
                self.rows.append(("blank", None))
            self.rows.append(("group", g))
            items = sorted(groups[g], key=lambda e: (e["tmux"]["window"], e["tmux"]["pane_index"]) if e["tmux"] else (0, 0))
            self.rows.extend(("item", e) for e in items)
        ids = [p["session_id"] for k, p in self.rows if k == "item"]
        if self.selected_id not in ids:
            self.selected_id = ids[0] if ids else None
        self.last_load = time.time()

    @staticmethod
    def redundant(panes, window_id):
        """True when the window has no real pane left, or an older sidebar (concurrent tmux hooks can add two)."""
        same = [(int(pid[1:]), p) for pid, p in panes.items() if p["window_id"] == window_id]
        if all(p["sidebar"] for _, p in same):
            return True
        return min(n for n, p in same if p["sidebar"]) != int(MY_PANE[1:])

    def maybe_reload(self):
        try:
            mtime = os.stat(STATE_DIR).st_mtime
        except FileNotFoundError:
            mtime = None
        if mtime != self.last_mtime or time.time() - self.last_load > 2:
            self.last_mtime = mtime
            self.reload()

    def put(self, y, x, s, attr=0):
        h, w = self.scr.getmaxyx()
        if 0 <= y < h and x < w:
            try:
                self.scr.addstr(y, x, truncate(s, w - x), attr)
            except curses.error:
                pass

    def draw(self):
        scr = self.scr
        scr.erase()
        h, w = scr.getmaxyx()
        now = time.time()

        counts = {s: 0 for s in STATES}
        for e in self.sessions:
            counts[e.get("state", "idle")] = counts.get(e.get("state", "idle"), 0) + 1
        self.put(0, 1, "Claude", curses.A_BOLD | curses.color_pair(5))
        x = 8
        for s in ("running", "waiting", "done"):
            if counts.get(s):
                icon, _, color = STATES[s]
                text = f"{icon}{counts[s]} "
                self.put(0, x, text, curses.color_pair(color))
                x += width_of(text)
        self.put(1, 0, "─" * w, curses.color_pair(4))

        self.row_at = {}
        y = 2
        if not self.rows:
            self.put(y, 1, "セッションなし", curses.color_pair(4))
        for kind, p in self.rows:
            if y >= h - 1:
                break
            if kind == "group":
                self.put(y, 1, f"▾ {p}", curses.A_BOLD)
            elif kind == "item":
                self.draw_item(y, w, p, now)
                self.row_at[y] = p["session_id"]
            y += 1
        self.put(h - 1, 1, "⏎移動 j/k選択 q閉じる", curses.color_pair(4))
        scr.refresh()

    def draw_item(self, y, w, e, now):
        state = e.get("state", "idle")
        icon, label, color = STATES.get(state, STATES["idle"])
        if state == "running":
            icon = SPINNER[self.frame % len(SPINNER)]
        sel = e["session_id"] == self.selected_id
        here = e["tmux"] and e["tmux"]["window_id"] == self.my_window
        base = curses.A_REVERSE if sel else 0

        name = os.path.basename(e.get("cwd") or "") or "?"
        if e["tmux"]:
            name = f"{e['tmux']['window']}:{name}"
        detail = e.get("detail") or ""
        right = f"{label} {age(now - e.get('since', e.get('updated_at', now)))}"
        if state in ("running", "waiting") and detail:
            right = f"{detail} {right}"

        if sel:
            self.put(y, 0, " " * w, base)
        self.put(y, 1, icon, base | curses.color_pair(color) | (curses.A_BOLD if state == "waiting" else 0))
        right_w = min(width_of(right), max(0, w - 12))
        right = truncate(right, right_w)
        name_w = w - 4 - right_w - 1
        self.put(y, 3, truncate(name, name_w), base | (curses.A_BOLD if here else 0))
        self.put(y, w - width_of(right) - 1, right, base | curses.color_pair(color))

    def item_ids(self):
        return [p["session_id"] for k, p in self.rows if k == "item"]

    def move(self, d):
        ids = self.item_ids()
        if not ids:
            return
        i = ids.index(self.selected_id) if self.selected_id in ids else 0
        self.selected_id = ids[max(0, min(len(ids) - 1, i + d))]

    def jump(self, sid):
        e = next((e for e in self.sessions if e["session_id"] == sid), None)
        if not e or not e["tmux"]:
            return False
        pane = e["pane"]
        tmux("switch-client", "-t", pane)
        tmux("select-window", "-t", pane)
        tmux("select-pane", "-t", pane)
        return True

    def run(self):
        self.reload()
        while True:
            self.maybe_reload()
            self.draw()
            self.frame += 1
            k = self.scr.getch()
            if k == -1:
                continue
            if k in (ord("j"), curses.KEY_DOWN):
                self.move(1)
            elif k in (ord("k"), curses.KEY_UP):
                self.move(-1)
            elif k in (ord("g"), curses.KEY_HOME):
                self.move(-10**6)
            elif k in (ord("G"), curses.KEY_END):
                self.move(10**6)
            elif k in (10, 13, curses.KEY_ENTER, ord("l")):
                if self.jump(self.selected_id) and POPUP:
                    return
            elif k == ord("q") or (k == 27 and POPUP):
                if POPUP:
                    return
                # Detached via tmux: closing all sidebars kills this pane (and its children) too.
                tmux("run-shell", "-b", f"'{os.path.join(BIN_DIR, 'cts')}' off")
                return
            elif k == ord("r"):
                self.reload()
            elif k == curses.KEY_MOUSE:
                try:
                    _, _, my, _, _ = curses.getmouse()
                except curses.error:
                    continue
                sid = self.row_at.get(my)
                if sid:
                    self.selected_id = sid
                    if self.jump(sid) and POPUP:
                        return


def main():
    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")
    try:
        curses.wrapper(lambda scr: App(scr).run())
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
