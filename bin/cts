#!/usr/bin/env bash
# tmux-side controller for the Claude sidebar.
#   cts toggle          open/close the sidebar in every window
#   cts ensure [win]    add the sidebar to a window if enabled and missing (tmux hooks)
#   cts fix-width [win] restore the sidebar width after a layout change (tmux hooks)
#   cts popup [pane]    show the list in a popup instead (pane: where it was opened from)
#   cts next|prev [pane] [client]  go to the next / previous done or waiting Claude

set -u
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SIDEBAR="$BIN_DIR/cts-sidebar"

opt() { local v; v=$(tmux show -gqv "$1"); echo "${v:-$2}"; }
width() { opt @cts_width 34; }
enabled() { [ "$(opt @cts_enabled off)" = "on" ]; }

sidebar_of() { # prints the sidebar pane id of a window, if any
  tmux list-panes -t "$1" -F '#{pane_id} #{@cts_sidebar}' 2>/dev/null | awk '$2 == "1" { print $1; exit }'
}

ensure() {
  local win="${1:-}"
  enabled || return 0
  [ -z "$win" ] && win=$(tmux display -p '#{window_id}')
  # One window switch fires several tmux hooks at once; serialize them so only one sidebar gets added.
  tmux wait-for -L "cts-$win"
  ensure_locked "$win"
  tmux wait-for -U "cts-$win"
  return 0
}

ensure_locked() {
  local win="$1" pane
  [ -n "$(sidebar_of "$win")" ] && return 0
  # Splitting a zoomed window would unzoom it; the sidebar is added on the next visit instead.
  [ "$(tmux display -p -t "$win" '#{window_zoomed_flag}' 2>/dev/null)" = "1" ] && return 0
  pane=$(tmux split-window -hbfd -l "$(width)" -t "$win" -P -F '#{pane_id}' "exec '$SIDEBAR'" 2>/dev/null) || return 0
  tmux set -p -t "$pane" @cts_sidebar 1
  tmux set -p -t "$pane" remain-on-exit off
}

fix_width() {
  local win="${1:-}" pane w
  [ -z "$win" ] && win=$(tmux display -p '#{window_id}')
  pane=$(sidebar_of "$win")
  [ -z "$pane" ] && return 0
  w=$(tmux display -p -t "$pane" '#{pane_width}')
  [ "$w" != "$(width)" ] && tmux resize-pane -t "$pane" -x "$(width)"
  return 0
}

close_all() {
  tmux list-panes -a -F '#{pane_id} #{@cts_sidebar}' | awk '$2 == "1" { print $1 }' |
    while read -r p; do tmux kill-pane -t "$p"; done
}

case "${1:-}" in
  toggle)
    if enabled; then
      tmux set -g @cts_enabled off
      close_all
    else
      tmux set -g @cts_enabled on
      tmux list-windows -a -F '#{window_id}' | while read -r w; do ensure "$w"; done
    fi ;;
  on)        tmux set -g @cts_enabled on; tmux list-windows -a -F '#{window_id}' | while read -r w; do ensure "$w"; done ;;
  off)       tmux set -g @cts_enabled off; close_all ;;
  ensure)    ensure "${2:-}" ;;
  fix-width) fix_width "${2:-}" ;;
  next|prev) exec "$SIDEBAR" --jump "$1" "${2:-}" "${3:-}" ;;
  popup)     tmux display-popup -E -w "$(( $(width) + 6 ))" -h 80% -T ' Claude ' "CTS_ORIGIN_PANE='${2:-}' '$SIDEBAR' --popup" ;;
  *) echo "usage: cts {toggle|on|off|ensure|fix-width|popup|next|prev}" >&2; exit 1 ;;
esac
